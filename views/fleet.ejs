<%- include('partials/header') %>
<%- include('partials/subtabs') %>
<section class="card">
  <h2><%= editing ? 'Edit vehicle' : 'Add a vehicle' %></h2>
  <form method="post" action="/fleet" class="form form-inline">
    <% if (editing) { %><input type="hidden" name="id" value="<%= editing.id %>"><% } %>
    <label>Vehicle No
      <input type="text" name="regNo" required value="<%= editing ? editing.regNo : '' %>" placeholder="e.g. TAM-143">
    </label>
    <label>Type
      <select name="type">
        <option value="dumper" <%= editing && editing.type === 'dumper' ? 'selected' : '' %>>Dumper</option>
        <option value="tanker" <%= editing && editing.type === 'tanker' ? 'selected' : '' %>>Tanker</option>
      </select>
    </label>
    <label>Capacity (CFT for dumper, gallons for tanker)
      <input type="number" name="capacity" min="0" step="any" required value="<%= editing ? editing.capacity : '' %>">
    </label>
    <button type="submit" class="btn btn-gold"><%= editing ? 'Save changes' : 'Add vehicle' %></button>
    <% if (editing) { %><a class="btn btn-ghost" href="/fleet">Cancel</a><% } %>
  </form>
</section>

<section class="card">
  <h2>Dumpers (<%= dumpers.length %>)</h2>
  <div class="table-wrap"><table class="table">
    <thead><tr><th>Vehicle No</th><th>Capacity (CFT)</th><th>Actions</th></tr></thead>
    <tbody>
      <% dumpers.forEach(v => { %>
      <tr><td><strong><%= v.regNo %></strong></td><td><%= v.capacity.toLocaleString('en-US') %></td>
        <td class="actions-cell"><a class="btn btn-small btn-navy" href="/fleet?edit=<%= v.id %>">Edit</a>
        <form method="post" action="/fleet/<%= v.id %>/delete" onsubmit="return confirm('Delete this vehicle?')"><button class="btn btn-small btn-danger" type="submit">Delete</button></form></td></tr>
      <% }) %>
    </tbody>
  </table></div>
</section>

<section class="card">
  <h2>Water Tankers (<%= tankers.length %>)</h2>
  <div class="table-wrap"><table class="table">
    <thead><tr><th>Vehicle No</th><th>Capacity (gallons)</th><th>Actions</th></tr></thead>
    <tbody>
      <% tankers.forEach(v => { %>
      <tr><td><strong><%= v.regNo %></strong></td><td><%= v.capacity.toLocaleString('en-US') %></td>
        <td class="actions-cell"><a class="btn btn-small btn-navy" href="/fleet?edit=<%= v.id %>">Edit</a>
        <form method="post" action="/fleet/<%= v.id %>/delete" onsubmit="return confirm('Delete this vehicle?')"><button class="btn btn-small btn-danger" type="submit">Delete</button></form></td></tr>
      <% }) %>
    </tbody>
  </table></div>
</section>
<%- include('partials/footer') %>
