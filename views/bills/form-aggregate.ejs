<%- include('../partials/header') %>
<section class="card">
  <h2><%= bill ? 'Edit bill ' + bill.billNo : 'New aggregate bill' %></h2>
  <form method="post" action="<%= bill ? '/bills/' + bill.id + '/update' : '/bills/aggregate' %>" id="billForm" data-bill-type="aggregate">
    <div class="form-grid">
      <label>Bill No
        <input type="text" name="billNo" value="<%= bill ? bill.billNo : nextBillNo %>">
        <small class="muted">Auto number is filled in — change it to set your own, or clear it to auto-generate.</small>
      </label>
      <label>Bill To (customer)
        <select name="customerName" id="customerName">
          <% customers.forEach(c => { %><option value="<%= c.name %>" data-project="<%= c.project %>" <%= bill && bill.customerName === c.name ? 'selected' : '' %>><%= c.name %></option><% }) %>
          <% if (bill && !customers.some(c => c.name === bill.customerName)) { %><option value="<%= bill.customerName %>" selected><%= bill.customerName %></option><% } %>
        </select>
      </label>
      <label>Project
        <input type="text" name="project" id="project" value="<%= bill ? bill.project : '' %>">
      </label>
      <label>Billing month
        <input type="text" name="billingMonth" placeholder="e.g. September 2026" value="<%= bill ? (bill.billingMonth || '') : '' %>">
      </label>
      <label>Date issued
        <input type="date" name="dateIssued" value="<%= bill ? bill.dateIssued : today %>">
      </label>
    </div>

    <h3>Trip lines</h3>
    <div class="table-wrap">
      <table class="table lines-table">
        <thead><tr><th>Date</th><th>Veh No</th><th>DC No</th><th>Description</th><th>Trip</th><th>Per Trip Cft</th><th>Rate</th><th>Amount</th><th></th></tr></thead>
        <tbody id="linesBody"></tbody>
      </table>
    </div>
    <div class="row-between">
      <button type="button" class="btn btn-ghost" id="addRowBtn">+ Add line</button>
      <p class="amount-preview">Grand Total: <strong>Rs <span id="grandTotal">0.00</span></strong></p>
    </div>
    <button type="submit" class="btn btn-gold btn-block"><%= bill ? 'Update bill' : 'Save bill' %></button>
  </form>
</section>

<datalist id="vehList">
  <% vehicles.forEach(v => { %><option value="<%= v.regNo %>"></option><% }) %>
</datalist>
<script>
  window.VEH_CAPS = <%- JSON.stringify(Object.fromEntries(vehicles.map(v => [v.regNo, v.capacity]))) %>;
  window.MAT_RATES = <%- JSON.stringify(Object.fromEntries(materials.map(m => [m.name, m.rate]))) %>;
  window.MAT_NAMES = <%- JSON.stringify(materials.map(m => m.name)) %>;
  window.DEFAULT_DATE = <%- JSON.stringify(today) %>;
  window.EXISTING_LINES = <%- JSON.stringify(bill ? bill.lines : null) %>;
</script>
<%- include('../partials/footer') %>
