<%- include('../partials/header') %>
<section class="card">
  <div class="row-between">
    <h2>Bills</h2>
    <div class="actions-row">
      <a class="btn btn-navy" href="/bills/new/aggregate">+ Aggregate bill</a>
      <a class="btn btn-gold" href="/bills/new/water">+ Sweet water bill</a>
      <a class="btn btn-ghost" href="/bills/import">📥 Excel import</a>
    </div>
  </div>
  <form method="get" action="/bills" class="filter-row">
    <select name="company">
      <option value="">All companies</option>
      <% companies.forEach(n => { %><option value="<%= n %>" <%= company === n ? 'selected' : '' %>><%= n %></option><% }) %>
    </select>
    <select name="type">
      <option value="">All types</option>
      <option value="aggregate" <%= type === 'aggregate' ? 'selected' : '' %>>Aggregate</option>
      <option value="water" <%= type === 'water' ? 'selected' : '' %>>Water</option>
    </select>
    <select name="status">
      <option value="">All statuses</option>
      <option value="unpaid" <%= status === 'unpaid' ? 'selected' : '' %>>Unpaid</option>
      <option value="paid" <%= status === 'paid' ? 'selected' : '' %>>Paid</option>
    </select>
    <input type="search" name="q" value="<%= q %>" placeholder="Search bill no, vehicle, DC no, PO no…">
    <button class="btn btn-small btn-navy" type="submit">Filter / Search</button>
    <% if (type || status || company || q) { %><a class="btn btn-small btn-ghost" href="/bills">Clear</a><% } %>
  </form>
  <% if (type || status || company || q) { %><p class="muted"><strong><%= bills.length %></strong> bill(s) found<% if (company) { %> for <strong><%= company %></strong><% } %> — Total: <strong>Rs <%= filteredTotal.toLocaleString('en-US', {minimumFractionDigits: 2}) %></strong></p><% } %>
  <% if (!bills.length) { %><p class="muted">No bills found.</p><% } %>
  <div class="table-wrap">
    <table class="table">
      <thead><tr><th>Bill No</th><th>Type</th><th>Company</th><th>Project</th><th>Date issued</th><th>Lines</th><th>Total (Rs)</th><th>Status</th><th>Saved by</th><th>Actions</th></tr></thead>
      <tbody>
        <% bills.forEach(b => { %>
        <tr>
          <td><a href="/bills/<%= b.id %>"><strong><%= b.billNo %></strong></a></td>
          <td><span class="badge <%= b.type === 'aggregate' ? 'st-confirmed' : 'st-pending' %>"><%= b.type === 'aggregate' ? 'Aggregate' : billCategoryLabel(b) %></span></td>
          <td><%= b.customerName %></td>
          <td><%= b.project %></td>
          <td><%= b.dateIssued %></td>
          <td><%= b.lines.length %></td>
          <td class="num"><strong><%= b.total.toLocaleString('en-US', {minimumFractionDigits: 2}) %></strong></td>
          <td><span class="badge <%= b.status === 'paid' ? 'st-delivered' : 'st-cancelled' %>"><%= b.status %></span></td>
          <td><%= b.savedBy %></td>
          <td class="actions-cell">
            <a class="btn btn-small btn-navy" href="/bills/<%= b.id %>">View</a>
            <a class="btn btn-small btn-gold" href="/bills/<%= b.id %>/edit">Edit</a>
            <a class="btn btn-small btn-ghost" href="/bills/<%= b.id %>/print">Print</a>
          </td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</section>
<%- include('../partials/footer') %>
