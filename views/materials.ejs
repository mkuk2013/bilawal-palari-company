<%- include('partials/header') %>
<%- include('partials/subtabs') %>
<section class="card">
  <h2><%= editing ? 'Edit material' : 'Add a material' %></h2>
  <form method="post" action="/materials" class="form form-inline">
    <% if (editing) { %><input type="hidden" name="id" value="<%= editing.id %>"><% } %>
    <label>Name
      <input type="text" name="name" required value="<%= editing ? editing.name : '' %>" placeholder="e.g. Coarse Aggregate">
    </label>
    <label>Unit
      <select name="unit">
        <% units.forEach(u => { %>
        <option value="<%= u %>" <%= editing && editing.unit === u ? 'selected' : '' %>><%= u %></option>
        <% }) %>
        <% if (editing && !units.includes(editing.unit)) { %>
        <option value="<%= editing.unit %>" selected><%= editing.unit %></option>
        <% } %>
      </select>
    </label>
    <label>Default rate (Rs)
      <input type="number" name="rate" min="0" step="any" required value="<%= editing ? editing.rate : '' %>">
    </label>
    <button type="submit" class="btn btn-gold"><%= editing ? 'Save changes' : 'Add material' %></button>
    <% if (editing) { %><a class="btn btn-ghost" href="/materials">Cancel</a><% } %>
  </form>
</section>

<section class="card">
  <h2>Units</h2>
  <p class="muted">Material ki units ki list — default CFT aur gallon hain; apni marzi ki unit bhi add kar sakte hain (misal: Ton, Trip, Bag). Jo unit kisi material par lagi ho, wo delete nahi hoti.</p>
  <div class="table-wrap"><table class="table">
    <thead><tr><th>Unit</th><th>Materials</th><th>Actions</th></tr></thead>
    <tbody>
      <% units.forEach(u => { const count = materials.filter(m => m.unit === u).length; %>
      <tr>
        <td><strong><%= u %></strong></td>
        <td><%= count %></td>
        <td class="actions-cell">
          <form method="post" action="/materials/units/delete" onsubmit="return confirm('Delete this unit?')"><input type="hidden" name="unit" value="<%= u %>"><button class="btn btn-small btn-danger" type="submit" <%= count > 0 ? 'disabled title="Pehle is unit ke materials change ya delete karein"' : '' %>>Delete</button></form>
        </td>
      </tr>
      <% }) %>
    </tbody>
  </table></div>
  <form method="post" action="/materials/units" class="form form-inline">
    <label>New unit
      <input type="text" name="unit" required placeholder="e.g. Ton / Trip / Bag">
    </label>
    <button type="submit" class="btn btn-navy">Add unit</button>
  </form>
</section>

<section class="card">
  <h2>Materials we supply</h2>
  <div class="table-wrap"><table class="table">
    <thead><tr><th>Material</th><th>Unit</th><th>Default Rate (Rs)</th><th>Actions</th></tr></thead>
    <tbody>
      <% materials.forEach(m => { %>
      <tr><td><strong><%= m.name %></strong></td><td>per <%= m.unit %></td><td><%= m.rate %></td>
        <td class="actions-cell"><a class="btn btn-small btn-navy" href="/materials?edit=<%= m.id %>">Edit</a>
        <form method="post" action="/materials/<%= m.id %>/delete" onsubmit="return confirm('Delete this material?')"><button class="btn btn-small btn-danger" type="submit">Delete</button></form></td></tr>
      <% }) %>
    </tbody>
  </table></div>
</section>
<%- include('partials/footer') %>
