  <a href="/inspector" class="<%= path.startsWith('/inspector') ? 'active' : '' %>"><span class="ic">🔍</span><span>Inspector</span></a>
  <a href="/fleet" class="<%= path.startsWith('/fleet') ? 'active' : '' %>"><span class="ic">🚚</span><span>Fleet</span></a>
  <a href="/materials" class="<%= path.startsWith('/materials') ? 'active' : '' %>"><span class="ic">🧱</span><span>Supply</span></a>
