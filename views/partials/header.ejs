<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title><%= title %> · Bilawal Palari &amp; Company</title>
<meta name="theme-color" content="#0a1e46">
<link rel="manifest" href="/manifest.webmanifest">
<link rel="icon" href="/App%20icon%20192.png" type="image/png">
<link rel="apple-touch-icon" href="/App%20icon%20192.png">
<link rel="stylesheet" href="/css/style.css?v=8">
</head>
<body>
<% if (currentUser) { %>
<header class="topbar no-print">
  <a class="brand" href="/">
    <img src="/logo.png" alt="Company logo">
    <span><%= company.name %></span>
  </a>
  <div class="top-actions">
    <form method="get" action="/bills" class="top-search">
      <input type="search" name="q" placeholder="🔍 Search bill no, company, vehicle…" aria-label="Search bills">
    </form>
    <span class="user-chip"><%= currentUser.username %> · <%= currentUser.role === 'admin' ? 'Admin' : 'User' %></span>
    <a class="btn btn-small btn-gold" href="/account/password">Password</a>
    <button type="button" class="btn btn-small btn-gold install-app-btn">&#128242; Install App</button>
    <a class="btn btn-small btn-outline" href="/logout">Logout</a>
  </div>
</header>
<div class="quickbar no-print">
  <div class="quickbar-in">
    <a class="qbar-btn" href="/">🏠 Home</a>
    <a class="qbar-btn qbar-primary" href="/orders/new">🧾 Book an order</a>
    <a class="qbar-btn" href="/bills/new/aggregate">🧱 Aggregate bill</a>
    <a class="qbar-btn" href="/bills/new/water">💧 Sweet water bill</a>
    <a class="qbar-btn" href="/bills/import">📥 Excel import</a>
    <a class="qbar-btn" href="/customers">🏢 Companies</a>
    <% if (currentUser.role === 'admin') { %><a class="qbar-btn" href="/admin">📊 Admin</a><% } %>
  </div>
</div>
<% } %>
<main class="container">
<% if (msg) { %><div class="alert alert-ok no-print"><%= msg %></div><% } %>
<% if (errorMsg) { %><div class="alert alert-err no-print"><%= errorMsg %></div><% } %>
