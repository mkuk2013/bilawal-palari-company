<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title><%= title %> · Bilawal Palari &amp; Company</title>
<meta name="theme-color" content="#0a1e46">
<link rel="manifest" href="/manifest.webmanifest">
<link rel="icon" href="/App%20icon%20192.png" type="image/png">
<link rel="apple-touch-icon" href="/App%20icon%20192.png">
<link rel="stylesheet" href="/css/style.css">
</head>
<body>
<% if (currentUser) { %>
<header class="topbar no-print">
  <a class="brand" href="/">
    <img src="/Company%20logo.jpg" alt="Company logo">
    <span><%= company.name %></span>
  </a>
  <div class="top-actions">
    <span class="user-chip"><%= currentUser.username %> · <%= currentUser.role === 'admin' ? 'Admin' : 'User' %></span>
    <a class="btn btn-small btn-gold" href="/account/password">Password</a>
    <a class="btn btn-small btn-outline" href="/logout">Logout</a>
  </div>
</header>
<% } %>
<main class="container">
<% if (msg) { %><div class="alert alert-ok no-print"><%= msg %></div><% } %>
<% if (errorMsg) { %><div class="alert alert-err no-print"><%= errorMsg %></div><% } %>
