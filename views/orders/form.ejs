<%- include('../partials/header') %>
<section class="card narrow">
  <h2><%= order ? 'Edit order #' + order.id : 'Book an order' %></h2>
  <% if (order && order.billedBillId) { %>
  <p class="flash flash-error">Note: ye order bill <%= order.billedBillNo %> mein save ho chuka hai — yahan ki tabdeeli se wo purana bill nahi badlega.</p>
  <% } %>
  <form method="post" action="<%= order ? '/orders/' + order.id + '/update' : '/orders' %>" class="form" id="orderForm">
    <label>Customer
      <select name="customerId" id="customerId" required>
        <% customers.forEach(c => { %><option value="<%= c.id %>" data-project="<%= c.project %>" <%= order && order.customerId === c.id ? 'selected' : '' %>><%= c.name %></option><% }) %>
      </select>
    </label>
    <label>Site / Project
      <input type="text" name="site" id="site" placeholder="Project / site name" value="<%= order ? order.site : '' %>">
    </label>
    <label>Material
      <select name="materialId" id="materialId" required>
        <% materials.forEach(m => { %><option value="<%= m.id %>" data-rate="<%= m.rate %>" data-unit="<%= m.unit %>" <%= order && order.materialId === m.id ? 'selected' : '' %>><%= m.name %> (Rs <%= m.rate %>/<%= m.unit %>)</option><% }) %>
      </select>
    </label>
    <label>Delivery date
      <input type="date" name="deliveryDate" required value="<%= order ? order.deliveryDate : new Date().toISOString().slice(0,10) %>">
    </label>
    <label>Vehicle
      <select name="vehicleId" id="vehicleId">
        <option value="">— Select vehicle —</option>
        <% vehicles.forEach(v => { %><option value="<%= v.id %>" data-capacity="<%= v.capacity %>" <%= order && order.vehicleId === v.id ? 'selected' : '' %>><%= v.regNo %> · <%= v.typeLabel %> · <%= v.capacity.toLocaleString('en-US') %> <%= v.unitLabel %></option><% }) %>
      </select>
    </label>
    <div class="form-row">
      <label>Trips
        <input type="number" name="trips" id="trips" min="0" step="1" value="<%= order ? order.trips : 1 %>" required>
      </label>
      <label>Per-trip Qty
        <input type="number" name="perTripQty" id="perTripQty" min="0" step="any" value="<%= order ? order.perTripQty : '' %>" required>
      </label>
      <label>Rate (Rs)
        <input type="number" name="rate" id="rate" min="0" step="any" value="<%= order ? order.rate : '' %>" required>
      </label>
    </div>
    <p class="amount-preview">Amount: <strong>Rs <span id="amountPreview"><%= order ? order.amount.toLocaleString('en-US', {minimumFractionDigits: 2}) : '0.00' %></span></strong> <span class="muted small">(trips × per-trip qty × rate)</span></p>
    <button type="submit" class="btn btn-gold btn-block"><%= order ? 'Save changes' : 'Book order' %></button>
    <% if (order) { %><p style="margin-top:10px"><a href="/orders">← Back to orders</a></p><% } %>
  </form>
</section>
<%- include('../partials/footer') %>
